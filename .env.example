APP_NAME=Taxpiya
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://TU-SERVICIO.onrender.com
APP_TIMEZONE=UTC

FRONTEND_URL=https://TU-SERVICIO.onrender.com
LOCALE=es

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/database/taxpiya.sqlite

JWT_DURATION=240
JWT_SECRET=
JWT_ALGORITHM=HS256

FIREBASE_PROJECT_ID=tax-piya
FIREBASE_CREDENTIALS=/var/www/html/storage/app/firebase/service-account.json
FIREBASE_CREDENTIALS_JSON=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=tax-piya.firebaseapp.com
FIREBASE_STORAGE_BUCKET=tax-piya.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=902300007872
FIREBASE_APP_ID=1:902300007872:web:3872bd28d8a36b8dffdc25
FCM_SCOPE=prod
TAXPIYA_USE_FIRESTORE=true
TAXPIYA_USE_FIREBASE_AUTH=true

# Persistencia SQLite en Render (respaldo gratis en GitHub — repo taxpiya-db-backup)
TAXPIYA_GITHUB_BACKUP=true
TAXPIYA_GITHUB_BACKUP_MINUTES=5
GITHUB_BACKUP_OWNER=sam3miro22-pixel
GITHUB_BACKUP_REPO=taxpiya-db-backup
GITHUB_BACKUP_PATH=taxpiya.sqlite
GITHUB_BACKUP_TOKEN=

GOOGLE_MAPS_KEY=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=log
